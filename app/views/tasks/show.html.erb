<% content_for :title, @task.title %>

<article class="task-detail">
  <h1><%= @task.title %></h1>

  <% if @task.description.present? %>
    <div class="task-description"><%= simple_format @task.description %></div>
  <% end %>

  <dl class="task-meta">
    <dt>Created</dt>
    <dd><%= @task.created_at.strftime("%b %-d, %Y at %H:%M") %></dd>
    <dt>Due</dt>
    <dd><%= @task.due_at.strftime("%b %-d, %Y at %H:%M") %></dd>
  </dl>
</article>
