<%= link_to "\u2190 All tasks", tasks_path %>

<% content_for :title, @task.title %>

<article class="task-detail">
  <h1><%= @task.title %> <%= render "status_badge", task: @task %></h1>

  <% if @task.description.present? %>
    <div class="task-description"><%= simple_format @task.description %></div>
  <% end %>

  <dl class="task-meta">
    <dt>Created</dt>
    <dd><%= @task.created_at.strftime("%b %-d, %Y at %H:%M") %></dd>
    <dt>Due</dt>
    <dd><%= @task.due_at.strftime("%b %-d, %Y at %H:%M") %></dd>
  </dl>

  <% if @task.files.attached? %>
    <section class="attachments">
      <h2>Attachments</h2>
      <ul>
        <% @task.files.each do |file| %>
          <li>
            <%= link_to file.filename, rails_blob_path(file, disposition: "attachment") %>
            <span class="attachment-size">(<%= number_to_human_size(file.byte_size) %>)</span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <div class="task-actions">
    <%= link_to "Edit", edit_task_path(@task), class: "button-link" %>
    <% if @task.completed? %>
      <%= button_to "Mark as not completed", task_completion_path(@task), method: :delete %>
    <% else %>
      <%= button_to "Mark as completed", task_completion_path(@task) %>
    <% end %>
    <%= button_to "Delete", @task, method: :delete, class: "button-danger",
          data: { turbo_confirm: "Delete this task permanently?" } %>
  </div>
</article>
