<% content_for :title, "Tasks" %>

<header class="list-header">
  <h1>Tasks</h1>
  <%= link_to "New task", new_task_path, class: "button-link" %>
</header>

<% if @tasks.any? %>
  <ul class="task-list">
    <% @tasks.each do |task| %>
      <li class="task-row">
        <div class="task-row-main">
          <%= link_to task.title, task, class: "task-title" %>
          <p class="task-due">Due <%= task.due_at.strftime("%b %-d, %Y at %H:%M") %></p>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="empty-state">No tasks yet. Create your first one!</p>
<% end %>
