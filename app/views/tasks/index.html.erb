<% content_for :title, "Tasks" %>

<header class="list-header">
  <h1>Tasks</h1>
  <%= link_to "New task", new_task_path, class: "button-link" %>
</header>

<nav class="filters" aria-label="Task filters">
  <%= link_to "All", tasks_path, class: ["pill", ("active" if params[:filter].blank?)] %>
  <%= link_to "Active", tasks_path(filter: "active"), class: ["pill", ("active" if params[:filter] == "active")] %>
  <%= link_to "Completed", tasks_path(filter: "completed"), class: ["pill", ("active" if params[:filter] == "completed")] %>
  <%= link_to "Overdue", tasks_path(filter: "overdue"), class: ["pill", ("active" if params[:filter] == "overdue")] %>
  <%= link_to "Due today", tasks_path(filter: "due_today"), class: ["pill", ("active" if params[:filter] == "due_today")] %>
</nav>

<% if @tasks.any? %>
  <ul class="task-list">
    <% @tasks.each do |task| %>
      <li class="task-row <%= "completed" if task.completed? %>">
        <div class="task-row-main">
          <%= link_to task.title, task, class: "task-title" %>
          <p class="task-due">Due <%= task.due_at.strftime("%b %-d, %Y at %H:%M") %></p>
        </div>
        <div class="task-row-side">
          <%= render "status_badge", task: task %>
          <% unless task.completed? %>
            <%= button_to "Done", task_completion_path(task), class: "button-small" %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="empty-state">No tasks here. Create one or switch filters.</p>
<% end %>
